---
/**
 * Category page: /tag/pastel/, /tag/blue/ and so on.
 *
 * Paths come from meta.json at build time, so the category list always matches
 * the dataset that was actually generated, no dead links to tags with zero
 * palettes behind them.
 */
import Layout from '../../layouts/Layout.astro';
import Feed from '../../components/Feed.astro';
import { getFirstRows, getMeta, SSG_BATCH } from '../../lib/data.server.js';
import { TAG_LANDING_PAGES } from '../../lib/routes.server.js';

export function getStaticPaths() {
  return getMeta().tags.map((tag) => ({
    params: { slug: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;

/*
 * Some tags have a dedicated landing page covering the same ground in more
 * depth. The map lives in routes.server.js so the canonical here and the
 * sitemap there can never disagree about which URL is the real one.
 */
const canonical = TAG_LANDING_PAGES[tag.slug];
const preRows = getFirstRows(`tag/${tag.slug}`, SSG_BATCH);

const site = Astro.site ?? new URL('https://palette-vault.example');
const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.origin}/` },
      { '@type': 'ListItem', position: 2, name: `${tag.label} palettes` },
    ],
  },
];
---

<Layout
  title={`${tag.label} color palettes, Palette Vault`}
  description={`${tag.label} color palettes, four colors each. Click any swatch to copy its HEX, `
    + `or open a palette to take all four and download it as a PNG.`}
  activeTag={tag.slug}
  schema={schema}
  canonical={canonical}
>
  <Feed
    title={`${tag.label} palettes`}
    subtitle={`Palettes tagged ${tag.label.toLowerCase()}, newest first.`}
    type="chunks"
    base={`/data/tag/${tag.slug}`}
    chunks={tag.chunks}
    preRows={preRows}
    emptyTitle={`No ${tag.label.toLowerCase()} palettes`}
    emptyText="Try another category from the sidebar."
  />
</Layout>
