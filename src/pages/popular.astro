---
/**
 * Popular — palettes ranked by like count.
 *
 * The only page whose data comes from Firebase rather than the static chunks:
 * orderByValue().limitToLast(N) over /palettes. Because the key of each node
 * is the palette slug, the colours arrive with the ranking and no chunk lookup
 * is needed — see lib/firebase.js.
 *
 * Deliberately not pre-rendered: the ranking changes continuously, so freezing
 * it into HTML at build time would be misleading.
 */
import Layout from '../layouts/Layout.astro';
import Feed from '../components/Feed.astro';
---

<Layout
  title="Popular palettes — Palette Vault"
  description="The most liked colour palettes, ranked live."
  active="popular"
>
  <Feed
    title="Popular"
    subtitle="Ranked by likes, updated live."
    type="popular"
    emptyTitle="No likes yet"
    emptyText="Be the first — like a palette and it will show up here."
  />
</Layout>
