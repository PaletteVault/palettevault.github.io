---
/**
 * Single palette page: /palette/4e1f6e3e3e7545a9a998e8de/
 *
 * The slug is four HEX codes in a row, so the address carries the whole
 * palette. The page needs no chunk request and no id, it rebuilds itself
 * entirely from the URL.
 *
 * Every palette in the library is pre-rendered (see PRERENDER_PALETTES). The
 * rewrite fallback in pages/palette/index.astro is kept as a safety net for a
 * slug that is well formed but not in the library, not as the normal path.
 *
 * It used to be the normal path for everything outside a 2000-page window,
 * which was fine on a host with rewrites and quietly wrong on GitHub Pages,
 * where the fallback is 404.html: those pages rendered correctly and answered
 * 404.
 *
 * These pages are also the only ones that can carry per-palette social
 * metadata, because crawlers do not run JavaScript and an og:image set on the
 * client would never be seen. That is why the PNGs are generated for exactly
 * this set of pages.
 */
import Layout from '../../layouts/Layout.astro';
import PaletteDetail from '../../components/PaletteDetail.astro';
import PaletteNeighbors from '../../components/PaletteNeighbors.astro';
import { getStaticLinkedRows } from '../../lib/data.server.js';
import { getPaletteGraph } from '../../lib/neighbors.server.js';
import { paletteName, paletteSlug } from '../../lib/palette.js';

export function getStaticPaths() {
  return getStaticLinkedRows().map((row) => {
    const colors = row.slice(1);
    return { params: { slug: paletteSlug(colors) }, props: { colors } };
  });
}

const { colors } = Astro.props;
const { slug } = Astro.params;

/*
 * The graph is memoised across the whole build, so this lookup costs nothing
 * per page. It can miss only if a slug reached this route without being in the
 * pre-rendered set, which cannot happen while both read getStaticLinkedRows,
 * but the block is skipped rather than assumed so a future change to either
 * one degrades instead of throwing.
 */
const neighbors = getPaletteGraph().get(slug);

const hexList = colors.map((hex) => `#${hex.toUpperCase()}`).join(' ');
const name = paletteName(colors);

const site = Astro.site ?? new URL('https://palette-vault.example');
const imagePath = `/p/${slug}.png`;
const pageUrl = new URL(`/palette/${slug}/`, site).href;
const pinImage = new URL(`/p/${slug}-pin.png`, site).href;

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.origin}/` },
      { '@type': 'ListItem', position: 2, name },
    ],
  },
  {
    '@type': 'ImageObject',
    name: `${name} color palette`,
    description: `Color palette ${hexList}`,
    contentUrl: new URL(imagePath, site).href,
    width: 1200,
    height: 630,
    license: `${site.origin}/`,
  },
];
---

<Layout
  title={`${name}, ${hexList}`}
  {/*
    Sized against the real bounds rather than one example. Generated names run
    from 7 characters ("Hot Ivy") to 20 ("Whispered Chartreuse"), and the hex
    list is always 31, so this template lands between 141 and 154 for every one
    of the thousands of palette pages. The first version I wrote fit the sample
    in the audit and overran the longest names by 30 characters.
  */}
  description={`${name} is a four-color palette of ${hexList}. Copy the HEX codes, read each color in RGB, HSL and OKLCH, or save a PNG.`}
  image={imagePath}
  schema={schema}
>
  <PaletteDetail
    colors={colors}
    slug={slug}
    image={imagePath}
    pageUrl={pageUrl}
    pinImage={pinImage}
  />

  {
    neighbors && (
      <PaletteNeighbors
        similar={neighbors.similar}
        prev={neighbors.prev}
        next={neighbors.next}
      />
    )
  }
</Layout>
