---
import ToolLayout from '../../components/ToolLayout.astro';
import { getTool } from '../../lib/routes.server.js';

const tool = getTool('extract');
---

<ToolLayout
  slug={tool.slug}
  title={tool.title}
  description={tool.description}
  intro="Drop in an image, paste a screenshot, or choose a file. Colors are clustered in OKLab so the result matches what you actually see. Nothing is uploaded — it all runs in your browser."
>
  <section id="extract" class="tool-panel">
    <div class="tool-controls">
      <label class="field">
        <span class="field__label">Colors</span>
        <select data-extract-count>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5" selected>5</option>
          <option value="6">6</option>
          <option value="8">8</option>
        </select>
      </label>

      <div class="field field--actions">
        <button type="button" class="action" data-extract-copy-all>Copy all</button>
      </div>
    </div>

    <label class="dropzone" data-extract-drop>
      <input type="file" accept="image/*" data-extract-input hidden />
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 16V4m0 0L8 8m4-4 4 4M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
      </svg>
      <span><strong>Choose an image</strong> or drop it here</span>
      <span class="dropzone__hint">You can also paste from the clipboard</span>
    </label>

    <div data-extract-output hidden>
      <img class="extract-preview" data-extract-preview alt="Uploaded image preview" />
      <div class="gen-swatches" data-extract-result></div>
    </div>
  </section>
</ToolLayout>

<script>
  import { initExtract } from '../../lib/tools/extract.js';
  initExtract();
</script>
