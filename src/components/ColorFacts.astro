---
/**
 * ============================================================================
 *  EVERYTHING FACTUAL ABOUT ONE COLOUR
 * ============================================================================
 *
 *  Sits between the swatch and the palette grid on a colour page: conversions,
 *  ramps, schemes, previews and ready-made CSS.
 *
 *  WHY THIS COMES BEFORE THE PALETTES
 *
 *  Somebody arriving on a page for one hex value has a question about that
 *  value. Palettes containing it are a good second thing to offer and a poor
 *  first one, because they answer a question the visitor did not ask yet.
 *
 *  WHY EVERY NUMBER IS COMPUTED, NOT STORED
 *
 *  All of this is derivable from six hex digits, so storing it would mean
 *  keeping thousands of rows in step with the formulas that produced them.
 *  These run at build time and the pages stay static.
 * ============================================================================
 */
import {
  hexToCmyk,
  hexToXyz,
  hexToYxy,
  hexToLab,
  hexToHunterLab,
  hexToBases,
  toWebSafe,
  dominantChannel,
  rgbShares,
  HUNTER_ILLUMINANT,
} from '../lib/color-spaces.js';
import { shades, tints, schemes } from '../lib/color-scales.js';
import { hexToRgb, hexToHsl, isDark, contrastRatio } from '../lib/palette.js';
import { hexToOklch } from '../lib/oklch.js';

const { hex, name } = Astro.props;

const clean = String(hex).replace(/[^0-9a-fA-F]/g, '').toLowerCase();
const HEX = `#${clean.toUpperCase()}`;
const lower = `#${clean}`;

const rgb = hexToRgb(clean);
const hsl = hexToHsl(clean);
const cmyk = hexToCmyk(clean);
const xyz = hexToXyz(clean);
const yxy = hexToYxy(clean);
const lab = hexToLab(clean);
const hunter = hexToHunterLab(clean);
const oklch = hexToOklch(clean);
const bases = hexToBases(clean);
const shares = rgbShares(clean);
const websafe = toWebSafe(clean);
const dominant = dominantChannel(clean);

const shadeRamp = shades(clean);
const tintRamp = tints(clean);
const scheme = schemes(clean);

const onWhite = contrastRatio(clean, 'ffffff');
const onBlack = contrastRatio(clean, '000000');

const f = (value, places = 4) => value.toFixed(places);
const pc = (value) => `${Math.round(value * 100)}`;

/*
 * HSV is shown because print and paint tools ask for it, and it is one line
 * from HSL rather than another conversion module.
 */
const max = Math.max(rgb.r, rgb.g, rgb.b) / 255;
const min = Math.min(rgb.r, rgb.g, rgb.b) / 255;
const hsv = {
  h: hsl.h,
  s: max === 0 ? 0 : ((max - min) / max) * 100,
  v: max * 100,
};

const spaces = [
  { label: 'RGB', values: [rgb.r, rgb.g, rgb.b] },
  { label: 'HSL', values: [`${Math.round(hsl.h)}°`, `${Math.round(hsl.s)}%`, `${Math.round(hsl.l)}%`] },
  { label: 'HSV', values: [`${Math.round(hsv.h)}°`, `${Math.round(hsv.s)}%`, `${Math.round(hsv.v)}%`] },
  { label: 'CMYK', values: [f(cmyk.c, 2), f(cmyk.m, 2), f(cmyk.y, 2), f(cmyk.k, 2)] },
  { label: 'XYZ', values: [f(xyz.X), f(xyz.Y), f(xyz.Z)] },
  { label: 'Yxy', values: [f(yxy.Y), f(yxy.x), f(yxy.y)] },
  { label: 'CIE-Lab', values: [f(lab.L), f(lab.a), f(lab.b)] },
  { label: 'Hunter Lab', values: [f(hunter.L), f(hunter.a), f(hunter.b)] },
  { label: 'OKLCH', values: [`${f(oklch.L * 100, 1)}%`, f(oklch.C, 3), `${f(oklch.h, 1)}°`] },
];

const baseRows = [
  ['Binary', bases.red.binary, bases.green.binary, bases.blue.binary],
  ['Octal', bases.red.octal, bases.green.octal, bases.blue.octal],
  ['Decimal', bases.red.decimal, bases.green.decimal, bases.blue.decimal],
  ['Hex', bases.red.hex, bases.green.hex, bases.blue.hex],
];

const schemeRows = [
  { label: 'Complementary', colors: scheme.complementary },
  { label: 'Triadic', colors: scheme.triadic },
  { label: 'Analogous', colors: scheme.analogous },
  { label: 'Monochromatic', colors: scheme.monochromatic },
];
---

<section class='facts'>
	<h2>{name ? `${name} color values` : `${HEX} color values`}</h2>

	{/*
	 * The swatch and the numbers side by side, not one after the other.
	 *
	 * A table of conversions on its own is a page of digits with nothing to
	 * check them against. Seeing the colour while reading its coordinates is
	 * the point of the section, and putting the two in one row means neither
	 * has to be remembered while looking at the other.
	 */}
	<div class='hero'>
		<div
			class={`hero__swatch ${isDark(clean) ? 'hero__swatch--dark' : 'hero__swatch--light'}`}
			style={`background:#${clean}`}
			data-copy={HEX}
			role='button'
			tabindex='0'
			title={`Copy ${HEX}`}>
			<span class='hero__hex'>{HEX}</span>
			<span class='hero__rgb'>rgb({rgb.r}, {rgb.g}, {rgb.b})</span>
		</div>

		<table class='facts__table hero__table'>
			<caption>Color spaces of {lower}</caption>
			<tbody>
				{
					spaces.map((row) => (
						<tr>
							<th scope='row'>{row.label}</th>
							{row.values.map((value) => (
								<td>{value}</td>
							))}
							{row.values.length === 3 && <td />}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<p>
		{HEX} is {rgb.r} red, {rgb.g} green and {rgb.b} blue.
		{dominant
			? ` Its ${dominant} channel carries the most of it.`
			: ' No single channel dominates it.'} The nearest of the 216 web safe
		colors is <a href={`/colors/web-safe/#${websafe}`}>#{websafe.toUpperCase()}</a>.
	</p>

	{/*
	 * Said on the page, not buried in a comment.
	 *
	 * A Lab number without its white point is not a number anybody can check,
	 * and Hunter Lab uses a different one here from CIE-Lab directly above it.
	 * A reader comparing against another table and finding a mismatch deserves
	 * to know why before they conclude one of us is wrong.
	 */}
	<p class='facts__note'>
		CIE-Lab, XYZ and Yxy are measured against D65, the white point sRGB itself
		is defined against. Hunter Lab uses the original illuminant C constants,
		which is what paint and plastics specifications quote, so the two Lab rows
		are not directly comparable. CMYK is the plain arithmetic conversion: real
		ink values depend on the press, the paper and the profile.
	</p>

	<table class='facts__table'>
		<caption>Base numbers</caption>
		<thead>
			<tr>
				<th scope='col'>Base</th>
				<th scope='col'>Red</th>
				<th scope='col'>Green</th>
				<th scope='col'>Blue</th>
			</tr>
		</thead>
		<tbody>
			{
				baseRows.map(([label, r, g, b]) => (
					<tr>
						<th scope='row'>{label}</th>
						<td>{r}</td>
						<td>{g}</td>
						<td>{b}</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<h3>{lower} mixed with black</h3>
	<p class='facts__lede'>
		Ten even steps of the classic shade ramp, worked out in RGB, which is how
		the term has always been defined and how other references list it. The
		OKLCH scale further down this page answers a different question: it steps
		by equal <em>perceived</em> amounts, so its values are not the same.
	</p>
	<ul class='ramp'>
		{
			shadeRamp.map((value) => (
				<li class='ramp__step' style={`background:#${value};color:${isDark(value) ? '#fff' : '#000'}`}>
					<span>#{value.toUpperCase()}</span>
				</li>
			))
		}
	</ul>

	<h3>{lower} mixed with white</h3>
	<p class='facts__lede'>The tint ramp, by the same rule in the other direction.</p>
	<ul class='ramp'>
		{
			tintRamp.map((value) => (
				<li class='ramp__step' style={`background:#${value};color:${isDark(value) ? '#fff' : '#000'}`}>
					<span>#{value.toUpperCase()}</span>
				</li>
			))
		}
	</ul>

	<h3>Channel shares</h3>
	<ul class='bars'>
		{
			[
				['Red', shares.red, '#e5484d'],
				['Green', shares.green, '#2ec27e'],
				['Blue', shares.blue, '#3584e4'],
			].map(([label, value, tone]) => (
				<li class='bars__row'>
					<span class='bars__label'>{label}</span>
					<span class='bars__track'>
						<span class='bars__fill' style={`width:${value}%;background:${tone}`} />
					</span>
					<span class='bars__value'>{value.toFixed(1)}%</span>
				</li>
			))
		}
	</ul>

	<h3>Color schemes</h3>
	<p class='facts__lede'>
		Turned in OKLCH rather than HSL, so every member keeps the lightness and
		chroma of the original instead of one of them arriving washed out.
	</p>

	{
		schemeRows.map((row) => (
			<div class='scheme'>
				<p class='scheme__label'>{row.label}</p>
				<ul class='scheme__row'>
					{row.colors.map((value) => (
						<li
							class='scheme__chip'
							style={`background:#${value};color:${isDark(value) ? '#fff' : '#000'}`}
						>
							#{value.toUpperCase()}
						</li>
					))}
				</ul>
			</div>
		))
	}

	<h3>{lower} on black and on white</h3>
	<div class='previews'>
		<p class='preview preview--dark' style={`color:#${clean}`}>
			The quick brown fox jumps over the lazy dog. {onBlack.toFixed(2)}:1
		</p>
		<p class='preview preview--light' style={`color:#${clean}`}>
			The quick brown fox jumps over the lazy dog. {onWhite.toFixed(2)}:1
		</p>
	</div>
	<p class='facts__note'>
		Body text needs 4.5:1 to meet AA and large text needs 3:1, so a ratio tells
		you which of the two backgrounds this color can be read on, and at what
		size.
	</p>

	<h3>CSS for {lower}</h3>
	<pre class='code'><code>{`color: ${lower};
background-color: ${lower};
border: 3px solid ${lower};
box-shadow: 1px 1px 3px 2px ${lower};
text-shadow: 4px 4px 2px rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.8);

/* Perceptually even, and what a modern stylesheet wants */
color: oklch(${f(oklch.L * 100, 1)}% ${f(oklch.C, 3)} ${f(oklch.h, 1)});`}</code></pre>
	<p class='facts__note'>
		The <a href='/tools/oklch/'>OKLCH form</a> is the same color stated so that
		lightening or darkening it moves by an amount the eye agrees with. Every
		current browser understands it.
	</p>
</section>

<script>
	/*
	 * Copy on the swatch itself, keyboard included.
	 *
	 * It carries role="button" and tabindex, so Enter and Space have to work or
	 * the role is a lie to a screen reader about something it cannot operate.
	 */
	document.querySelectorAll('.hero__swatch[data-copy]').forEach((node) => {
		const copy = async () => {
			try {
				await navigator.clipboard.writeText(node.getAttribute('data-copy'));
				node.classList.add('is-copied');
				setTimeout(() => node.classList.remove('is-copied'), 700);
			} catch {
				/* Clipboard refused, not worth interrupting anybody over. */
			}
		};

		node.addEventListener('click', copy);
		node.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				copy();
			}
		});
	});
</script>

<style>
	.facts {
		margin: 2.5rem 0;
	}

	.facts__lede,
	.facts__note {
		color: var(--text-muted);
		font-size: 0.95em;
	}

	.facts__note {
		margin-top: 0.5rem;
	}

	/* ---------------------------------------------------------------- hero -- */

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		gap: 18px;
		align-items: start;
		margin: 1rem 0 1.25rem;
	}

	/*
	 * Stacks early. Below this width the table's four columns start wrapping
	 * inside their cells, and a conversion split across two lines is harder to
	 * read than one sitting under a swatch.
	 */
	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}

	.hero__swatch {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		min-height: 260px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		cursor: pointer;
		font-variant-numeric: tabular-nums;
	}

	.hero__swatch--dark {
		color: #fff;
	}

	.hero__swatch--light {
		color: #000;
	}

	.hero__hex {
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.hero__rgb {
		font-size: 0.95rem;
		opacity: 0.85;
	}

	.hero__swatch.is-copied .hero__hex::after {
		content: ' copied';
		font-weight: 500;
		opacity: 0.8;
	}

	.hero__table {
		margin: 0;
	}

	.facts__table {
		width: 100%;
		border-collapse: collapse;
		margin: 1rem 0;
		font-variant-numeric: tabular-nums;
	}

	.facts__table caption {
		text-align: left;
		font-weight: 700;
		padding-bottom: 6px;
	}

	.facts__table th,
	.facts__table td {
		border-bottom: 1px solid var(--border);
		padding: 7px 10px 7px 0;
		text-align: left;
	}

	.facts__table th[scope='row'] {
		font-weight: 600;
		white-space: nowrap;
	}

	/* ------------------------------------------------------------- ramps -- */

	/*
	 * One strip, not eleven cards. A ramp is read as a gradient, and gaps
	 * between the steps break the very continuity it exists to show.
	 */
	.ramp {
		display: flex;
		list-style: none;
		margin: 0.75rem 0 1.5rem;
		padding: 0;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--border);
	}

	.ramp__step {
		flex: 1 1 0;
		min-width: 0;
		aspect-ratio: 1 / 2;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding-bottom: 6px;
		font-size: 10px;
		font-weight: 600;
	}

	.ramp__step span {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		padding-bottom: 4px;
	}

	@media (max-width: 640px) {
		.ramp__step span {
			display: none;
		}

		.ramp__step {
			aspect-ratio: 1 / 3;
		}
	}

	/* -------------------------------------------------------------- bars -- */

	.bars {
		list-style: none;
		margin: 0.75rem 0 1.5rem;
		padding: 0;
	}

	.bars__row {
		display: grid;
		grid-template-columns: 3.5rem 1fr 3.5rem;
		align-items: center;
		gap: 10px;
		margin-bottom: 6px;
	}

	.bars__track {
		height: 12px;
		border-radius: 999px;
		background: var(--bg-alt, rgba(128, 128, 128, 0.15));
		overflow: hidden;
	}

	.bars__fill {
		display: block;
		height: 100%;
	}

	.bars__value {
		text-align: right;
		font-variant-numeric: tabular-nums;
		color: var(--text-muted);
		font-size: 0.9em;
	}

	/* ------------------------------------------------------------ schemes -- */

	.scheme {
		margin-bottom: 1rem;
	}

	.scheme__label {
		margin: 0 0 6px;
		font-weight: 600;
	}

	.scheme__row {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.scheme__chip {
		flex: 1 1 6rem;
		padding: 14px 8px;
		border-radius: var(--radius);
		text-align: center;
		font-size: 11px;
		font-weight: 600;
		border: 1px solid var(--border);
	}

	/* ----------------------------------------------------------- previews -- */

	.previews {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
		margin: 0.75rem 0;
	}

	@media (max-width: 560px) {
		.previews {
			grid-template-columns: 1fr;
		}
	}

	.preview {
		margin: 0;
		padding: 18px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
	}

	.preview--dark {
		background: #000;
	}

	.preview--light {
		background: #fff;
	}

	/* --------------------------------------------------------------- code -- */

	.code {
		margin: 0.75rem 0;
		padding: 14px 16px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: var(--bg-alt, rgba(128, 128, 128, 0.08));
		overflow-x: auto;
		font-size: 13px;
		line-height: 1.6;
	}
</style>
