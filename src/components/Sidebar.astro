---
/** Category sidebar: style tags and base colors. */
import { getTagGroups, TAG_DOT } from '../lib/data.server.js';

interface Props {
  /** Slug of the active tag, when a category page is open. */
  activeTag?: string | null;
}

const { activeTag = null } = Astro.props;
const groups = getTagGroups();
---

<aside class="sidebar">
  {
    groups.map((group) => (
      group.items.length > 0 && (
        <section class="sidebar__group">
          <h2 class="sidebar__title">{group.title}</h2>
          <ul class="sidebar__list">
            {group.items.map((tag) => (
              <li>
                <a
                  class="tag"
                  href={`/tag/${tag.slug}/`}
                  title={`${tag.label} color palettes`}
                  aria-current={activeTag === tag.slug ? 'page' : undefined}
                >
                  {TAG_DOT[tag.slug] && (
                    <span class="tag__dot" style={`--dot:${TAG_DOT[tag.slug]}`} aria-hidden="true" />
                  )}
                  {tag.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    ))
  }
</aside>
