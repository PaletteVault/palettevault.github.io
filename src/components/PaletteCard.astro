---
/**
 * A palette card rendered at build time.
 *
 * The markup is not duplicated: it comes from lib/card.js, the same module
 * gallery.js uses for infinite scroll. That guarantees static and dynamically
 * inserted cards are identical.
 */
import { cardHTML } from '../lib/card.js';

interface Props {
  /** Tuple [id, hex1, hex2, hex3, hex4] from a chunk. */
  row: [number, string, string, string, string];
  /** Contents of data/meta.json, needed to derive the date from the id. */
  meta: Record<string, unknown>;
}

const { row, meta } = Astro.props;
const html = cardHTML(row, meta);
---

<Fragment set:html={html} />
